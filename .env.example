# Copy to .env and fill in. Never commit .env.
#
# Roboflow API key for the nota-pembelian dataset.
# Get one at https://app.roboflow.com -> Settings -> API Keys
ROBOFLOW_API_KEY=

# Dataset coordinates (defaults match the corpus the models are trained on)
ROBOFLOW_WORKSPACE=ocr-fqwqd
ROBOFLOW_PROJECT=nota-pembelian
ROBOFLOW_VERSION=9
